@model Employee

@{
    ViewData["Title"] = "Employee Details";
}

<h2>Employee Details</h2>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">Salary</dt>
    <dd class="col-sm-10">@Model.Salary</dd>

    <dt class="col-sm-2">Department</dt>
    <dd class="col-sm-10">@Model.Department?.Name</dd>

    <dt class="col-sm-2">Hire Date</dt>
    <dd class="col-sm-10">@Model.HireDate.ToString("yyyy-MM-dd")</dd>
</dl>

<h4>Tasks</h4>

@if (Model.Tasks.Count == 0)
{
    <div class="alert alert-info">This employee has no tasks.</div>
}
else
{
    <ul class="list-group mb-3">
        @foreach (var task in Model.Tasks)
        {
            <li class="list-group-item">
                @task.Title
                @if (task.IsCompleted)
                {
                    <span class="badge bg-success">Done</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">Pending</span>
                }
            </li>
        }
    </ul>
}

<a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
<a class="btn btn-secondary" asp-action="Index">Back to list</a>