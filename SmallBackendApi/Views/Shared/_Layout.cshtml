<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Employees</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="EmployeesMvc" asp-action="Index">Employees</a>
            <div class="d-flex align-items-center text-white">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="me-3">Hello, @User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-outline-light">Logout</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-sm btn-outline-light me-2" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Register">Register</a>
                }
            </div>
        </div>
    </nav>

    <div class="container">
        @RenderBody()
    </div>
</body>
</html>  